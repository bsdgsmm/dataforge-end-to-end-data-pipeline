# Copy to .env and replace every placeholder before starting the stack.
# .env is git-ignored; never commit real credentials.

# Warehouse database (also used to create the PostgreSQL superuser in Docker)
DATAFORGE_DB_HOST=localhost
DATAFORGE_DB_PORT=5433
DATAFORGE_DB_NAME=marketplace
DATAFORGE_DB_USER=dataforge
DATAFORGE_DB_PASSWORD=replace-with-a-local-password

# Pipeline behaviour
DATAFORGE_MAX_REJECTED_RATIO=0.02
DATAFORGE_LOG_LEVEL=INFO

# Airflow metadata database (created on first PostgreSQL start)
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace-with-another-local-password

# Shared secret that signs tokens between Airflow components. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=replace-with-a-random-string

# Host port for the Airflow UI and the container user id (use `id -u` on Linux)
AIRFLOW_HOST_PORT=8080
AIRFLOW_UID=50000
